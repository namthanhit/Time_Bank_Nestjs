generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WalletStatus {
  active
  frozen
  closed
}

enum EscrowWalletStatus {
  released
  pending
  refunded
}

enum TransferStatus {
  pending
  completed
  cancelled
  failed
}

enum LedgerDirection {
  debit
  credit
}

enum LedgerRefType {
  transfer
  escrow
  adjustment
}

enum Visibility {
  public
  friends
  hidden
}

enum ServiceStatus {
  pending
  open
  matched
  completed
  cancelled
  expired
}

enum OfferStatus {
  pending     // vừa apply
  accepted    // được requester duyệt
  rejected    // bị từ chối
  withdrawn   // người offer tự rút
  cancelled
}

enum BookingStatus {
  scheduled
  ongoing
  completed
  ended
  cancelled
}

enum UserStatus {
  draft
  pending
  active
  suspended
  banned
}

enum Gender {
  male
  female
  other
  unknown
}

enum VerificationChannel {
  sms
  email
}

enum VerificationPurpose {
  signup
  phone_change
  email_change
  reset_password
  mfa
}

enum SignupStep {
  init
  otp_sent
  verified
  personal_info
  pin_set
  password_set
  completed
}

enum TwoFactorMethod {
  sms
  email
  app
}

enum RegionType {
  country
  province
  district
  ward
}

model User {
  id                 String      @id @default(cuid())
  full_name          String      @db.VarChar(150)
  citizen_id         String?     @unique @db.VarChar(64)
  phone              String      @unique @db.VarChar(32)
  email              String?     @unique @db.VarChar(320)
  avatar_url         String?     @db.VarChar(255) 
  qr_code            String?     @db.VarChar(2048)
  status             UserStatus  @default(draft)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @default(now()) @updatedAt
  deleted_at         DateTime?

  detail             UserDetail?
  auth               Auth?
  verification_codes VerificationCode[]
  signup_sessions    SignupSession[]
  refresh_tokens     RefreshToken[]
 

  following Follow[] @relation("UserFollows")
  followers Follow[] @relation("UserFollowed")
  Wallet Wallet[]
  UserSkill UserSkill[]
  Service Service[]
  Offer Offer[]
  favorites Favorite[]
  requesterBookings Booking[] @relation("RequesterBookings")
  providerBookings Booking[] @relation("ProviderBookings")
  rateeRatings Rating[] @relation("RateeRatings")
  raterRatings Rating[] @relation("RaterRatings")
}

model UserDetail {
  user_id        String    @id                                         // Dùng user_id làm PK
  birth_date     DateTime?                                              // Ngày sinh
  gender         Gender    @default(unknown)                            // Giới tính
  description    String?   @db.VarChar(512)                             // Mô tả cá nhân
  region_id      String?                                                // Mã vùng (tham chiếu bảng Region) 
  street         String?   @db.VarChar(255)                            // Tên đường
  work_address   String?   @db.VarChar(255)                             // Địa chỉ làm việc
  study_address  String?   @db.VarChar(255)                             // Địa chỉ học tập
  social_network Json?                                                  // Thông tin mạng xã hội
  updated_at     DateTime  @updatedAt @default(now())                              // Thời điểm cập nhật

  // Quan hệ
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  region         Region?   @relation(fields: [region_id], references: [id])
}

model Region {
  id             String       @id @default(cuid())
  name           String
  code           Int?         
  codename       String?
  division_type  String?
  phone_code     Int?
  short_codename String?

  type           RegionType
  parent_id      String?
  parent         Region?      @relation("RegionHierarchy", fields: [parent_id], references: [id])
  children       Region[]     @relation("RegionHierarchy")

  // Quan hệ ngược
  usersDetail      UserDetail[]

  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt
}

model Auth {
  user_id             String     @id                                    // Dùng user_id làm PK
  password            String?    @db.VarChar(255)                       // Hash mật khẩu
  password_changed_at DateTime?                                         // Thời điểm đổi mật khẩu
  phone_verified_at   DateTime?                                         // Xác thực số điện thoại
  email_verified_at   DateTime?                                         // Xác thực email
  mfa_enabled         Boolean    @default(false)                        // Đã bật MFA chưa
  two_factor_method   TwoFactorMethod?                                  // Phương thức 2FA
  failed_attempts     Int        @default(0)                            // Số lần đăng nhập sai
  locked_until        DateTime?                                         // Khóa đến thời điểm nào
  pin                 String?    @db.VarChar(255)                       // Hash của mã PIN
  pin_set_at          DateTime?                                         // Ngày đặt PIN
  pin_failed_attempts Int        @default(0)                            // Số lần nhập PIN sai
  pin_locked_until    DateTime?                                         // Thời điểm khóa PIN
  created_at          DateTime   @default(now())                        // Tạo lúc
  updated_at          DateTime   @updatedAt @default(now())                             // Cập nhật lúc

  // Quan hệ
  user                User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id            BigInt                @id @default(autoincrement())      // Khóa chính tự tăng
  user_id       String?                                                  // Tham chiếu user (nullable)
  channel       VerificationChannel                                   // Kênh gửi mã (SMS/Email)
  purpose       VerificationPurpose                                   // Mục đích (signup, reset_password, ...)
  sent_to       String                @db.VarChar(320)                  // Nơi gửi tới (số hoặc email)
  code_hash     String                @db.VarChar(255)                  // Hash của mã OTP
  code_length   Int                   @default(6)                       // Độ dài mã
  attempts      Int                   @default(0)                       // Số lần thử nhập
  max_attempts  Int                   @default(5)                       // Giới hạn số lần nhập sai
  expires_at    DateTime                                              // Hết hạn
  consumed_at   DateTime?                                             // Đã sử dụng
  created_at    DateTime              @default(now())                   // Thời điểm tạo

  // Quan hệ
  user          User?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model SignupSession {
  id                  String         @id @default(cuid())                // ID dạng cuid() (UUID string)
  user_id             String?                                           // User liên kết (nullable)
  session_token_hash  String         @db.VarChar(255)                   // Hash của token trả về client
  current_step        SignupStep     @default(init)                     // Bước hiện tại trong signup flow
  expires_at          DateTime                                          // Hết hạn session
  ip                  String?        @db.VarChar(45)                    // IP tạo session
  created_at          DateTime       @default(now())                    // Ngày tạo

  // Quan hệ
  user                User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id           BigInt     @id @default(autoincrement())                 // Khóa chính
  user_id      String                                             // FK tới user
  token_hash   String      @db.VarChar(255)                            // Hash token
  device_info  String?     @db.VarChar(255)                            // Thông tin thiết bị
  ip           String?     @db.VarChar(45)                             // IP đăng nhập
  expires_at   DateTime                                              // Thời điểm hết hạn
  revoked_at   DateTime?                                             // Nếu bị revoke
  created_at   DateTime     @default(now())                            // Thời điểm tạo

  // Quan hệ
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  follower_id String   // người đi theo dõi
  followee_id String   // người được theo dõi
  created_at  DateTime @default(now())

  follower User @relation("UserFollows", fields: [follower_id], references: [id], onDelete: Cascade)
  followee User @relation("UserFollowed", fields: [followee_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, followee_id])
}

model Wallet {
  id         String       @id @default(cuid())
  user_id    String       @unique
  secs       Int          @default(0)
  status     WalletStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @default(now()) @updatedAt

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transfersFrom Transfer[]    @relation("FromWallet")
  transfersTo   Transfer[]    @relation("ToWallet")
  ledgerEntries LedgerEntry[]
}

model EscrowWallet {
  id             String       @id @default(cuid())
  job_id         String       @unique
  secs           Int          @default(0)
  status         EscrowWalletStatus @default(pending)
  
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt

  service        Service       @relation(fields: [job_id], references: [id], onDelete: Cascade)
  transfersTo    Transfer[]    @relation("ToEscrow")
  transfersFrom  Transfer[]    @relation("FromEscrow")
}

model Transfer {
  id               String         @id @default(cuid())
  from_wallet_id   String?
  to_wallet_id     String?
  from_escrow_id   String?
  to_escrow_id     String?
  secs             Int
  status           TransferStatus @default(pending)
  note             String?        @db.VarChar(200)
  created_at       DateTime       @default(now())
  completed_at     DateTime?
  cancelled_at     DateTime?
  failed_at        DateTime?

  fromWallet Wallet?        @relation("FromWallet", fields: [from_wallet_id], references: [id], onDelete: SetNull)
  toWallet   Wallet?        @relation("ToWallet", fields: [to_wallet_id], references: [id], onDelete: SetNull)

  fromEscrow EscrowWallet?  @relation("FromEscrow", fields: [from_escrow_id], references: [id], onDelete: SetNull)
  toEscrow   EscrowWallet?  @relation("ToEscrow", fields: [to_escrow_id], references: [id], onDelete: SetNull)
}

model LedgerEntry {
  id         String          @id @default(cuid())
  wallet_id  String
  direction  LedgerDirection
  secs       Int
  ref_type   LedgerRefType
  ref_id     String
  memo       String?         @db.VarChar(200)
  created_at DateTime        @default(now())

  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
}

model Skill {
  id        String  @id @default(cuid())
  parent_id String?
  name      String  @db.VarChar(80)
  slug      String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  parent        Skill?         @relation("SkillHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children      Skill[]        @relation("SkillHierarchy")
  userSkills    UserSkill[]
  serviceSkills ServiceSkill[]
}

model UserSkill {
  user_id  String
  skill_id String

  user  User  @relation(fields: [user_id], references: [id])
  skill Skill @relation(fields: [skill_id], references: [id])

  @@id([user_id, skill_id])
}

model Service {
  id              String   @id @default(cuid())
  user_id         String
  title           String   @db.VarChar(120)
  description     String?  @db.Text
  region_code     String?  @db.VarChar(32)
  place           String   @db.VarChar(255)
  preferred_start DateTime?
  time            Int
  slot            Int @default(60)
  visibility      Visibility @default(public)
  status          ServiceStatus @default(open)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  serviceImages ServiceImage[]
  serviceSkills ServiceSkill[]
  escrowWallet   EscrowWallet?
  offers  Offer[]
  bookings Booking[]
  favorites Favorite[]
}

model ServiceSkill {
  service_id String
  skill_id   String

  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([service_id, skill_id])
}

model Favorite {
  id          String   @id @default(cuid())
  user_id     String
  service_id  String
  created_at  DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([user_id, service_id])
}


model Offer {
  id               String      @id @default(cuid())
  service_id       String
  user_id          String
  note             String?     @db.Text
  status           OfferStatus @default(pending)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @default(now()) @updatedAt

  service  Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  service_id     String
  offer_id       String
  requester_id   String //chủ job
  provider_id    String //người nhận job
  start_at       DateTime
  secs_booked    Int
  place          String?       @db.VarChar(160)
  status         BookingStatus @default(scheduled)
  created_at     DateTime      @default(now())
  check_in_time  DateTime?
  completed_at   DateTime?
  cancelled_at   DateTime?

  service   Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  offer     Offer    @relation(fields: [offer_id], references: [id], onDelete: Cascade)
  requester User     @relation("RequesterBookings", fields: [requester_id], references: [id], onDelete: Cascade)
  provider  User     @relation("ProviderBookings", fields: [provider_id], references: [id], onDelete: Cascade)
  ratings   Rating[]
}

model Rating {
  id         String   @id @default(cuid())
  booking_id String
  rater_id   String
  ratee_id   String
  stars      Int
  comment    String?  @db.VarChar(300)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  rater   User    @relation("RaterRatings", fields: [rater_id], references: [id], onDelete: Cascade)
  ratee   User    @relation("RateeRatings", fields: [ratee_id], references: [id], onDelete: Cascade)

  ratingImages RatingImage[]                  

  @@unique([booking_id, rater_id], name: "booking_id_rater_id")// mỗi rater 1 rating/booking
  @@index([ratee_id])                         // truy vấn thống kê rating theo người nhận
}


model ServiceImage {
  id         String   @id @default(cuid())
  service_id String
  image_id   String
  created_at DateTime @default(now())

  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [image_id], references: [id], onDelete: Cascade)

  @@unique([service_id, image_id])
}

model Image {
  id          String   @id @default(cuid())
  url         String   @db.VarChar(2048)
  alt_text    String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  serviceImages ServiceImage[]
  ratingImages  RatingImage[]
}

model RatingImage {
  id         String   @id @default(cuid())
  rating_id  String
  image_id   String
  position   Int      @default(0)              // để sắp xếp ảnh trong bài đánh giá
  caption    String?  @db.VarChar(255)         // mô tả ngắn cho ảnh (tuỳ chọn)
  created_at DateTime @default(now())

  rating Rating @relation(fields: [rating_id], references: [id], onDelete: Cascade)
  image  Image  @relation(fields: [image_id], references: [id], onDelete: Cascade)

  @@unique([rating_id, image_id])              // tránh gắn trùng cùng 1 ảnh
  @@index([rating_id, position])
}
